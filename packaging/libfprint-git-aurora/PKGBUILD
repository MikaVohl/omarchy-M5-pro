prepare() {
  cd libfprint
  local p
  for p in "${_patches[@]}"; do
    patch -p1 --fuzz=0 < "$srcdir/$p"
  done
  install -Dm644 "$srcdir/apple-sep.h" aurora-uapi/linux/apple-sep.h
}

build() {
  CFLAGS+=" -I$srcdir/libfprint/aurora-uapi"
  arch-meson libfprint build -D drivers=all -D installed-tests=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$srcdir/fprintd-aurora-touchid.conf" \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/50-libfprint-aurora-touchid.conf"
}
