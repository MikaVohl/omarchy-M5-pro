# J716s (omarchy-M5-pro): libfprint with the aurora Touch ID driver for
# /dev/sep-bio interface version 5.
#
# Omarchy's libfprint-git carries the aurora driver for interface version 4
# only, and the pinned J716s kernel speaks version 5, so fprintd ignores the
# reader ("interface version 5, expected 4"). This builds libfprint 1.94.100
# with aurora-silicon/aurora-sep-userspace's complete aurora patch series at a
# pinned commit (the same series its Fedora libfprint carries), including
# 0005, which accepts v4 and v5. The UAPI header is the pinned kernel's.
#
# Packaged under Omarchy's name, libfprint-git, so Omarchy's fingerprint setup
# and its migrations treat it as installed. Epoch 2 keeps the Omarchy v4-only
# build from replacing it on update; drop this package (pacman -S
# libfprint-git from the omarchy repository) once Omarchy's build accepts v5.

pkgname=libfprint-git
pkgver=1.94.100.aurora.a227a35
pkgrel=1
epoch=2
pkgdesc="Library for fingerprint readers, with the aurora Apple Touch ID driver for /dev/sep-bio interface v4 and v5"
url="https://fprint.freedesktop.org/"
arch=(aarch64)
license=(LGPL-2.1-or-later)
depends=(gcc-libs glib2 glibc libgudev libgusb openssl pixman)
makedepends=(git glib2-devel gobject-introspection gtk-doc meson python-cairo python-gobject systemd)
provides=("libfprint=1.94.100" libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)
_userspace=https://raw.githubusercontent.com/aurora-silicon/aurora-sep-userspace/a227a350d7ba2753e674b887c5f8304354732ee7/libfprint
_patches=(
  libfprint-1.94.100-apple-sep.patch
  0002-aurora-report-unusable-captures-as-retries.patch
  0003-hide-lid-covered-readers-while-the-lid-is-closed.patch
  0004-aurora-refuse-unbound-enrollment.patch
  0005-aurora-support-v4-and-v5.patch
  0006-aurora-report-finger-lift-and-lockout.patch
  0007-aurora-name-retry-causes-and-keep-waiting.patch
  0008-aurora-report-the-touch-id-lockout-as-locked-out.patch
  0009-aurora-say-why-touch-id-needs-the-password.patch
  0010-let-a-front-end-ask-whether-the-reader-needs-the-password.patch
  0011-aurora-name-a-touch-of-another-enrolled-finger.patch
)
source=(
  "git+https://gitlab.freedesktop.org/libfprint/libfprint.git#commit=80a4b5ec612892c5c056c48dddaa561452cf37ec"
  "${_patches[@]/#/$_userspace/}"
  "$_userspace/fprintd-aurora-touchid.conf"
  "apple-sep.h::https://raw.githubusercontent.com/rolotrealanis98/linux/8ab10100a4c1c944797e3fc8345589aff57777df/include/uapi/linux/apple-sep.h"
)
