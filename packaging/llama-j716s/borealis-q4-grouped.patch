Subject: ggml-vulkan: group Q4_K zero-point terms for dense GEMV

Four activation lanes share each zero-point scale. Sum each quartet
before applying its scale to shorten the serial FMA chain. Keep FP32
arithmetic, quantized layout, dispatch and routed-expert paths intact.
Select this only in an isolated candidate until measured and checked.

--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp
@@ -74,12 +74,24 @@
             const FLOAT_TYPE sy = fma(FLOAT_TYPE(by132.x),     q4_4,  fma(FLOAT_TYPE(by132.y), q4_5,  fma(FLOAT_TYPE(by132.z), q4_6,  FLOAT_TYPE(by132.w) * q4_7)));
             const FLOAT_TYPE sz = fma(FLOAT_TYPE(by20.x),      q4_8,  fma(FLOAT_TYPE(by20.y),  q4_9,  fma(FLOAT_TYPE(by20.z),  q4_10, FLOAT_TYPE(by20.w) *  q4_11)));
             const FLOAT_TYPE sw = fma(FLOAT_TYPE(by232.x),     q4_12, fma(FLOAT_TYPE(by232.y), q4_13, fma(FLOAT_TYPE(by232.z), q4_14, FLOAT_TYPE(by232.w) * q4_15)));
-            const FLOAT_TYPE smin =
+            FLOAT_TYPE smin;
+#ifndef MUL_MAT_ID
+            if (NUM_COLS == 1) {
+                // Sum each group of activations before applying its shared minimum.
+                const vec4 p0 = vec4(by10.x, by132.x, by20.x, by232.x);
+                const vec4 p1 = vec4(by10.y, by132.y, by20.y, by232.y);
+                const vec4 p2 = vec4(by10.z, by132.z, by20.z, by232.z);
+                const vec4 p3 = vec4(by10.w, by132.w, by20.w, by232.w);
+                const vec4 sum = (p0 + p1) + (p2 + p3);
+                smin = fma(sum.x, sc2, fma(sum.y, sc3, fma(sum.z, sc6, sum.w * sc7)));
+            } else
+#endif
+            smin =
                 fma(FLOAT_TYPE(by10.x), sc2, fma(FLOAT_TYPE(by132.x), sc3, fma(FLOAT_TYPE(by20.x), sc6, fma(FLOAT_TYPE(by232.x), sc7,
                 fma(FLOAT_TYPE(by10.y), sc2, fma(FLOAT_TYPE(by132.y), sc3, fma(FLOAT_TYPE(by20.y), sc6, fma(FLOAT_TYPE(by232.y), sc7,
                 fma(FLOAT_TYPE(by10.z), sc2, fma(FLOAT_TYPE(by132.z), sc3, fma(FLOAT_TYPE(by20.z), sc6, fma(FLOAT_TYPE(by232.z), sc7,
                 fma(FLOAT_TYPE(by10.w), sc2, fma(FLOAT_TYPE(by132.w), sc3, fma(FLOAT_TYPE(by20.w), sc6,     FLOAT_TYPE(by232.w) * sc7)))))))))))))));
             temp[j][n] = fma(dm.x, fma(sx, sc0, fma(sy, sc1, fma(sz, sc4, sw * sc5))), fma(-dm.y, smin, temp[j][n]));
         }
     }
 }
