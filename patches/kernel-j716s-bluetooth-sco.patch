+/* Airship::tr_controller::sync 0x2617e9b30 and transfer_queue completion
+ * dispatch 0x261850d40 in the paired native cache: completion flags are in
+ * descriptor byte 15, not the length/type word. Codes 3/5/6 are failures;
+ * code 4 normalizes to successful code 2. Code 1 is not a final completion
+ * and is not supported by this single-descriptor synchronous path.
+ */
+static int cen_sco_descriptor_status(const u8 *descriptor, u16 tag)
+{
+	if (descriptor[0] != 1 || get_unaligned_le16(descriptor + 12) != tag)
+		return -EPROTO;
+	switch ((descriptor[15] >> 1) & 7) {
+	case 0:
+	case 2:
+	case 4:
+		return 0;
+	case 3:
+	case 5:
+	case 6:
+		return -EIO;
+	default:
+		return -EPROTO;
+	}
+}
+
+static int cen_sco_reclaim(struct cen_bt *bt)
+{
+	const struct cen_aux_spec *spec = &cen_aux_specs[CEN_SCO_TX_AUX];
+	u16 tail = cen_tail(bt, spec->id), pending, completed;
+
+	if (tail >= spec->slots)
+		return -EPROTO;
+	pending = (bt->sco_tx_head + spec->slots - bt->sco_tx_complete) % spec->slots;
+	completed = (tail + spec->slots - bt->sco_tx_complete) % spec->slots;
+	if (completed > pending)
+		return -EPROTO;
+	while (bt->sco_tx_complete != tail) {
+		u8 *descriptor = bt->arena + bt->aux[CEN_SCO_TX_AUX].offset +
+				 bt->sco_tx_complete * (16 + spec->footer);
+		int ret;
+
+		dma_rmb();
+		ret = cen_sco_descriptor_status(descriptor, bt->sco_tx_complete + 1);
+		if (ret)
+			return ret;
+		bt->sco_tx_complete = (bt->sco_tx_complete + 1) % spec->slots;
+	}
+	return 0;
+}
+
+static int cen_sco_packet_length(const u8 *data, u32 length)
+{
+	u32 packet_length, pos;
+
+	if (length < HCI_SCO_HDR_SIZE)
+		return -EPROTO;
+	/* Standard HCI SCO handle + packet-status bits only. Extended native
+	 * packet types/headers are not silently treated as standard SCO.
+	 */
+	if (get_unaligned_le16(data) & 0xc000)
+		return -EOPNOTSUPP;
+	packet_length = HCI_SCO_HDR_SIZE + data[2];
+	if (packet_length > length)
+		return -EPROTO;
+	for (pos = packet_length; pos < length;) {
+		if (!data[pos])
+			break;
+		if (data[pos] == 1)
+			pos++;
+		else if (data[pos] == 2 && length - pos >= 9)
+			pos += 9;
+		else
+			return -EPROTO;
+	}
+	return packet_length;
+}
+
+static int cen_receive_sco(struct cen_bt *bt, const u8 *data, u32 length)
+{
+	struct sk_buff *skb;
+	int packet_length = cen_sco_packet_length(data, length);
+
+	if (packet_length < 0)
+		return packet_length;
+	/* Metadata attributes are not HCI audio bytes. Native status remains in
+	 * handle bits 13:12; do not invent a status from an opaque attribute.
+	 */
+	skb = bt_skb_alloc(packet_length, GFP_KERNEL);
+	if (!skb) {
+		bt->hdev->stat.err_rx++;
+		return 0;
+	}
+	skb_put_data(skb, data, packet_length);
+	hci_skb_pkt_type(skb) = HCI_SCODATA_PKT;
+	bt->hdev->stat.byte_rx += packet_length;
+	hci_recv_frame(bt->hdev, skb);
+	return 0;
+}
