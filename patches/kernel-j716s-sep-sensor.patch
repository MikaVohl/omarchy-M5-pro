+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! J716s sensor-auth admission only; no transport, persistence or biometric API.
+
+pub(crate) const MAX_CONTAINER: usize = 16 * 1024 * 1024;
+pub(crate) const MAX_ROOT_TRANSFER: usize = 0x4b000;
+const MAX_IMAGE: usize = 4 * 1024 * 1024;
+
+pub(crate) struct Policy {
+    pub(crate) j716s: bool,
+    pub(crate) opt_in: u32,
+    pub(crate) xart_writes: u8,
+    pub(crate) provision_keybag: u8,
+    pub(crate) xart_guard: i8,
+    pub(crate) trusted_keys: u8,
+    pub(crate) filevault_api: u8,
+    pub(crate) discovery_only: bool,
+    pub(crate) spi_override: bool,
+    pub(crate) test_fault: u8,
+}
+
+impl Policy {
+    pub(crate) fn admitted(&self) -> bool {
+        self.j716s && self.opt_in == 1 && self.xart_writes == 0
+            && self.provision_keybag == 0 && self.xart_guard == 2
+            && self.trusted_keys == 0 && self.filevault_api == 0
+            && self.discovery_only && !self.spi_override && self.test_fault == 0
+    }
+}
+
+pub(crate) fn identity_admitted(id: u16, idle: bool, silent: bool, finger: bool) -> bool {
+    id == 0x3356 && idle && !silent && !finger
+}
+
+pub(crate) fn nonempty_value(bytes: &[u8]) -> bool {
+    !bytes.is_empty() && !bytes.iter().all(|b| *b == 0)
+        && !bytes.iter().all(|b| *b == 0xff)
+}
+
+/// Only the eight commands of the bounded session, with exact request geometry.
+pub(crate) fn request_admitted(opcode: u16, bytes: &[u8]) -> bool {
+    match opcode {
+        0x73 => bytes == 6u32.to_le_bytes(),
+        0x48 => bytes.len() == 12 && nonempty_value(bytes),
+        0x80 => bytes == 0x3356u16.to_le_bytes(),
+        0x17 => bytes.len() == 16 && nonempty_value(bytes),
+        0x81 => bytes.len() == 32 && nonempty_value(bytes),
+        0x86 => !bytes.is_empty() && bytes.len() <= MAX_ROOT_TRANSFER,
+        0x15 => bytes == 1u32.to_le_bytes(),
+        0x16 => bytes.len() == 40 && nonempty_value(bytes),
+        _ => false,
+    }
+}
+// Fixed-shape canonical DER parsing with borrowed slices, no recursion or allocation.
+
+fn take<'a>(bytes: &mut &'a [u8], tag: u8) -> Option<&'a [u8]> {
+    if bytes.first().copied()? != tag { return None; }
+    let first = *bytes.get(1)?;
+    let (len, header): (usize, usize) = if first < 0x80 {
+        (usize::from(first), 2)
+    } else {
+        let count = usize::from(first & 0x7f);
+        if count == 0 || count > 4 || *bytes.get(2)? == 0 { return None; }
+        let mut len = 0usize;
+        for b in bytes.get(2..2 + count)? {
+            len = len.checked_mul(256)?.checked_add(usize::from(*b))?;
+        }
+        if len < 128 { return None; }
+        (len, 2 + count)
+    };
+    let end = header.checked_add(len)?;
+    let body = bytes.get(header..end)?;
+    *bytes = bytes.get(end..)?;
+    Some(body)
+}
+
+fn named<'a>(bytes: &mut &'a [u8], name: &[u8]) -> Option<&'a [u8]> {
+    let mut sequence = take(bytes, 0x30)?;
+    if take(&mut sequence, 0x16)? != name { return None; }
+    Some(sequence)
+}
+
+fn image_admitted(bytes: &[u8], kind: &[u8]) -> Option<()> {
+    if bytes.len() > MAX_IMAGE { return None; }
+    let mut outer = bytes;
+    let mut image = named(&mut outer, b"IMG4")?;
+    if !outer.is_empty() { return None; }
+    let mut payload = named(&mut image, b"IM4P")?;
+    if take(&mut payload, 0x16)? != kind { return None; }
+    let version = take(&mut payload, 0x16)?;
+    if !version.is_ascii() { return None; }
+    let data = take(&mut payload, 0x04)?;
+    if data.is_empty() || !payload.is_empty() { return None; }
+    // The pinned factory parser requires CALB in the first 256 FSC2 bytes.
+    if kind == b"FSC2" && !data[..data.len().min(256)].windows(4).any(|b| b == b"CALB") {
+        return None;
+    }
+    let mut wrapper = take(&mut image, 0xa0)?;
+    if !image.is_empty() { return None; }
+    let mut manifest = named(&mut wrapper, b"IM4M")?;
+    if !wrapper.is_empty() { return None; }
+    // Canonical non-negative version, signed property set, signature and certificates.
+    let version = take(&mut manifest, 0x02)?;
+    if version.is_empty() || version[0] & 0x80 != 0
+        || (version.len() > 1 && version[0] == 0 && version[1] & 0x80 == 0)
+        || take(&mut manifest, 0x31)?.is_empty()
+        || take(&mut manifest, 0x04)?.is_empty()
+        || take(&mut manifest, 0x30)?.is_empty()
+        || !manifest.is_empty() { return None; }
+    Some(())
+}
+
+/// Shape/type/size admission only, NOT signature verification or same-unit provenance.
+/// Those are required by the private factory extractor and ultimately by sepOS.
+pub(crate) fn container_admitted(bytes: &[u8], kind: &[u8]) -> bool {
+    fn check(bytes: &[u8], kind: &[u8]) -> Option<()> {
+        if bytes.is_empty() || bytes.len() > MAX_CONTAINER { return None; }
+        let mut outer = bytes;
+        let mut comb = named(&mut outer, b"comb")?;
+        if !outer.is_empty() { return None; }
+        let mut fdrd = named(&mut comb, b"fdrd")?;
+        image_admitted(take(&mut fdrd, 0x04)?, kind)?;
+        if !fdrd.is_empty() { return None; }
+        let mut secb = named(&mut comb, b"secb")?;
+        if take(&mut secb, 0x04)?.is_empty() || !secb.is_empty() || !comb.is_empty() {
+            return None;
+        }
+        Some(())
+    }
+    check(bytes, kind).is_some()
+}
