+
+impl SensorAuthProbe<'_> {
+    fn step(&mut self, stage: u8) -> Result<()> {
+        self.stage = stage;
+        self.status = u32::MAX;
+        diag::sensor_auth(stage, 0, self.status);
+        if self.sep.shutting_down.load(Relaxed) || self.sep.suspending.load(Relaxed)
+            || !self.sep.sleep_gate().may_request()
+            || self.sep.phase.load(Relaxed) != PHASE_EXCHANGE {
+            return Err(ESHUTDOWN);
+        }
+        Ok(())
+    }
+
+    fn request(&mut self, opcode: u16, name: &'static CStr, bytes: &[u8]) -> Result<KVec<u8>> {
+        if !sensor_auth::request_admitted(opcode, bytes) { return Err(EPERM); }
+        if self.sep.shutting_down.load(Relaxed) || self.sep.suspending.load(Relaxed)
+            || !self.sep.sleep_gate().may_request() { return Err(ESHUTDOWN); }
+        let done = self.sep.sbio_transfer_raw(opcode, name, bytes)?;
+        self.status = done.status.answered().unwrap_or(u32::MAX);
+        diag::sensor_auth(self.stage, 0, self.status);
+        if !done.status.is_ok() {
+            // In particular, 0x16 is a refusal here, never a resumed session.
+            // xART write-disabled refusals are retained; do not relax policy.
+            return Err(EPERM);
+        }
+        Ok(done.payload)
+    }
