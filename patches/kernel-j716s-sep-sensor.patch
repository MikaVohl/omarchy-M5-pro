+/// Auth probe only: readiness polling is bounded, frames are read exactly once.
+/// A stale/unexpected frame or CRC failure stops the attempt; never drain/retry.
+fn auth_read_frame(total: usize, out: &mut [u8]) -> Result<()> {
+    if !(SENSOR_SERIAL_AT + CRC_LEN..=MAX_REPLY).contains(&total)
+        || SENSOR_SERIAL_AT + out.len() != total - CRC_LEN {
+        return Err(EINVAL);
+    }
+    for _ in 0..READ_POLL_ATTEMPTS {
+        let st = status()?;
+        if st.is_silent() || st.finger_present() { return Err(EIO); }
+        match st.offset12() {
+            Offset12::Available(count) if count as usize == total => {
+                let mut buf = FrameBuf::new();
+                read_reply_ready(total, &mut buf.0)?;
+                if !frame_crc_valid(&buf.0[..total]) { return Err(EIO); }
+                out.copy_from_slice(&buf.0[SENSOR_SERIAL_AT..total - CRC_LEN]);
+                return Ok(());
+            }
+            Offset12::Identifier(_) => {},
+            _ => return Err(EIO),
+        }
+        fsleep(Delta::from_millis(READ_POLL_MS));
+    }
+    Err(ETIMEDOUT)
+}
