+struct ane_fw_preload_build {
+	const char *name;
+	u64 dva[2];
+	u64 size[2];
+	const u8 *text_pin;
 };
 
 /* Later firmware generations must never enter the H14 staging path. */
@@ -99,24 +107,66 @@
 	u16 dart_revision;
 	u8 dapf_count;
 	const u8 *text_pin;
-};
-
-/* Pure range check: the boot loader supplies the physical addresses. */
+	/* When present, the table replaces the single-layout admission above. */
+	const struct ane_fw_preload_build *preload_builds;
+	u8 preload_build_count;
+};
+
+/* Pure bounded geometry check; reservations are validated separately. */
+static inline bool
+ane_fw_preload_layout_match(const u64 want_dva[2], const u64 want_size[2],
+			    const u64 phys[2], const u64 size[2], const u64 dva[2])
+{
+	u64 physical_end[2], device_end[2];
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		if (!phys[i] || !dva[i] || !size[i] ||
+		    !IS_ALIGNED(phys[i], SZ_16K) || !IS_ALIGNED(dva[i], SZ_16K) ||
+		    !IS_ALIGNED(size[i], SZ_16K) ||
+		    size[i] != want_size[i] || dva[i] != want_dva[i] ||
+		    check_add_overflow(phys[i], size[i], &physical_end[i]) ||
+		    check_add_overflow(dva[i], size[i], &device_end[i]))
+			return false;
+	}
+	return (physical_end[0] <= phys[1] || physical_end[1] <= phys[0]) &&
+	       (device_end[0] <= dva[1] || device_end[1] <= dva[0]);
+}
+
+static inline const struct ane_fw_preload_build *
+ane_fw_preload_build(const struct ane_fw_platform *soc, const u64 phys[2],
+		     const u64 size[2], const u64 dva[2])
+{
+	unsigned int i;
+
+	for (i = 0; i < soc->preload_build_count; i++)
+		if (ane_fw_preload_layout_match(soc->preload_builds[i].dva,
+						soc->preload_builds[i].size, phys, size, dva))
+			return &soc->preload_builds[i];
+	return NULL;
+}
+
 static inline bool
 ane_fw_preload_ranges_valid(const struct ane_fw_platform *soc, const u64 phys[2],
 			    const u64 size[2], const u64 dva[2])
 {
-	u64 end[2];
-	unsigned int i;
-
-	for (i = 0; i < 2; i++) {
-		if (!phys[i] || !IS_ALIGNED(phys[i], SZ_16K) ||
-		    size[i] != soc->preload_size[i] ||
-		    dva[i] != soc->preload_dva[i] ||
-		    check_add_overflow(phys[i], size[i], &end[i]))
-			return false;
-	}
-	return end[0] <= phys[1] || end[1] <= phys[0];
+	if (soc->preload_build_count)
+		return ane_fw_preload_build(soc, phys, size, dva) != NULL;
+	return ane_fw_preload_layout_match(soc->preload_dva, soc->preload_size, phys, size, dva);
+}
+
+/* NULL means no recognized bounded image may be read or acquired. */
+static inline const u8 *
+ane_fw_preload_text_pin(const struct ane_fw_platform *soc, const u64 phys[2],
+			const u64 size[2], const u64 dva[2])
+{
+	const struct ane_fw_preload_build *build;
+
+	if (!soc->preload_build_count)
+		return ane_fw_preload_layout_match(soc->preload_dva, soc->preload_size,
+						   phys, size, dva) ? soc->text_pin : NULL;
+	build = ane_fw_preload_build(soc, phys, size, dva);
+	return build ? build->text_pin : NULL;
 }
 
