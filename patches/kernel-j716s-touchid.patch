+/// J716s Touch ID: J714s's sensor and nonce protocol with macOS's measured
+/// registration capacity. Selected unless `keystore_only=1` asks for the
+/// discovery-only profile above.
+pub(crate) const T6050_J716S: PlatformProfile = PlatformProfile {
+    name: "T6050/J716s",
+    shmem_capacity: 0x1c000,
+    ..T6050
+};
+
 /// MacBook Air M4 (J713). The J713 ADT (26.6.2, 25G83) puts the Mesa sensor
 /// on spi2 at `0x3ad108000`, 8 MHz, chip select 0, with power on the NUB GPIO
 /// controller (pin 28) and data-ready on AP GPIO 199. The SEP is
@@ -658,7 +667,11 @@ fn t6020_profile() -> &'static PlatformProfile {
 /// rather than guessed at, so the driver cannot run a handshake with the wrong
 /// geometry.
 pub(crate) fn detect() -> Result<&'static PlatformProfile> {
-    select(&machine_has, &t6020_profile)
+    let profile = select(&machine_has, &t6020_profile)?;
+    if profile.name == T6050_J716S_PROBE.name && !crate::attach::discovery_only_requested() {
+        return Ok(&T6050_J716S);
+    }
+    Ok(profile)
 }
 
 /// The profile for a machine whose root `compatible` list `has` answers for,
@@ -813,6 +826,10 @@ fn t8132_selection_is_limited_to_the_m4_airs() {
