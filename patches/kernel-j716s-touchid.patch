+        assert!(T6050_J716S.shmem_capacity == 0x1c000);
+        assert!(T6050_J716S.persistent_enrol);
+        assert!(T6050_J716S.xart_guard == 1);
+        assert!(T6050_J716S.sensor.controller_base == 0x5_0510_8000);
         assert_eq!(picked(&[b"apple,t6050"]), None);
     }
 
