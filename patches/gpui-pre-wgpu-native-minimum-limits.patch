+    #[test]
+    fn native_shader_interfaces_fit_requested_limits() {
+        let requested = crate::wgpu_context::REQUIRED_INTER_STAGE_SHADER_VARIABLES;
+        let mut maximum = 0;
+        for (name, source, capabilities) in [
+            ("storage", STORAGE_BUFFER_SHADERS, naga::valid::Capabilities::empty()),
+            (
+                "subpixel",
+                SUBPIXEL_SHADERS,
+                naga::valid::Capabilities::DUAL_SOURCE_BLENDING,
+            ),
+        ] {
+            let module = validate_wgsl(source, capabilities);
+            for entry in &module.entry_points {
+                let (variables, locations) = match entry.stage {
+                    naga::ShaderStage::Vertex => {
+                        let result = entry.function.result.as_ref().expect("vertex output");
+                        interface_requirement(&module, result.ty, result.binding.as_ref(), false)
+                    }
+                    naga::ShaderStage::Fragment => entry.function.arguments.iter().fold(
+                        (0, 0),
+                        |(variables, locations), argument| {
+                            let (count, ceiling) = interface_requirement(
+                                &module,
+                                argument.ty,
+                                argument.binding.as_ref(),
+                                true,
+                            );
+                            (variables + count, locations.max(ceiling))
+                        },
+                    ),
+                    _ => panic!("unexpected native shader stage: {:?}", entry.stage),
+                };
+                // All native pipelines use triangle topologies, not PointList.
+                let required = variables.max(locations);
+                assert!(
+                    required <= requested,
+                    "{name}/{} requires {required} inter-stage variables, requested {requested}",
+                    entry.name,
+                );
+                maximum = maximum.max(required);
+            }
+        }
+        assert_eq!(maximum, requested, "request only the audited shader minimum");
+    }
+
+    fn interface_requirement(
+        module: &naga::Module,
+        ty: naga::Handle<naga::Type>,
+        binding: Option<&naga::Binding>,
